# Anthropic API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 번역에 쓸 모델. 더 싸게 쓰려면 claude-sonnet-5-5 또는 claude-haiku-5-5
MODEL=claude-opus-5-5

PORT=3000

# 폰 등 다른 기기에서도 쓰려면 비밀번호를 설정하세요.
# 설정하면 같은 Wi-Fi 의 기기에서 접속할 수 있고, 접속할 때 비밀번호를 묻습니다.
# 비워 두면 이 컴퓨터에서만 접속됩니다.
# APP_PASSWORD=나만아는비밀번호
