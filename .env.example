# Anthropic API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 번역에 쓸 모델. 더 싸게 쓰려면 claude-sonnet-5-5 또는 claude-haiku-5-5
MODEL=claude-opus-5-5

# 접속 주소. 기본값은 이 컴퓨터에서만 접속 가능 (127.0.0.1)
HOST=127.0.0.1
PORT=3000

# 다른 기기(폰 등)에서 접속하려면 HOST=0.0.0.0 으로 바꾸고 비밀번호를 반드시 설정하세요
# APP_PASSWORD=나만아는비밀번호
